# Copy to .env (git-ignored) and fill in. Real environment variables override these.
# Local Ollama: leave OLLAMA_API_KEY empty.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=nemotron-3-ultra
OLLAMA_API_KEY=
OLLAMA_TIMEOUT=180
# Ollama Cloud instead:
# OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=your-key-here
